<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>1.0.0</Version>
        <Authors>JBraunsmaJr</Authors>
        <Description>Super basic ability to create a PDF via Razor syntax. However, it's mostly used by PDFLib.Chromium for signing PDFs... because it became apparent that HTML/CSS was the way to go</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageReference Include="SkiaSharp" Version="4.156.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    </ItemGroup>

</Project>
